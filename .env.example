# .env - Variables de entorno locales para Lokitrono
# IMPORTANTE: Reemplaza estos valores con tus claves y tokens reales de cada servicio gratuito.
GITHUB_TOKEN=ghp_tuTokenDeGitHubAqui
SUPABASE_URL=https://tu-id-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tuClaveServiceRoleAqui
VERCEL_TOKEN=tuTokenDeVercelAqui
GMAIL_CLIENT_ID=tuGmailClientId.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=tuGmailClientSecret
GMAIL_REFRESH_TOKEN=tuGmailRefreshToken
DRIVE_REFRESH_TOKEN=tuDriveRefreshToken
ONEDRIVE_REFRESH_TOKEN=tuOneDriveRefreshToken
